<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 viene incluido en Windows 10/11: el .exe no necesita instalar nada. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TecnoticsDock</AssemblyName>
    <RootNamespace>TecnoticsDock</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Tecnotics Dock</Product>
    <Company>Tecnotics</Company>
    <Description>Panel rapido para la segunda pantalla: volumen, discos, Wi-Fi y apps</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="assets\logo.png" LogicalName="logo.png" />
  </ItemGroup>

</Project>
